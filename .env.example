# ============================================================
# .env.example — copy to .env.local and fill in.
#
#   cp .env.example .env.local
#
# .env.local is gitignored and must never be committed.
# Full walkthrough: docs/self-hosting.md
# ============================================================

# ── Required: Supabase project ──────────────────────────────
# Supabase dashboard → Project Settings → API
#
# The project URL. Looks like https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable ("anon") key, from the "API Keys" tab — the key that
# starts with sb_publishable_. Safe to expose: it carries no privileges
# of its own, and every table is protected by row-level security.
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY is still read as a fallback for older
# projects that only have the legacy JWT-style anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ── Optional: service role ──────────────────────────────────
# Supabase dashboard → Project Settings → API → "secret" key
# (starts with sb_secret_, previously called service_role).
#
# BYPASSES ROW-LEVEL SECURITY COMPLETELY. Never prefix it with
# NEXT_PUBLIC_, never import it into a component, never commit it.
# On Netlify set it as a regular (non-public) environment variable.
#
# The app works without it: build-time content reads use the
# publishable key so a cached page can only ever contain what an
# anonymous visitor may see. Set this only if you add server-side
# features that must act beyond the caller's own rights.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here

# ── Optional: local Postgres for the schema tests ────────────
# `npm run pg:start` starts a throwaway cluster and these defaults
# match it, so you normally do not need to set them. Point them at
# another local cluster if you prefer.
#
# NEVER point these at a real Supabase project: docs/schema.sql begins
# by dropping every Feyn table.
# PGHOST=/tmp/feyn-pg
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres
